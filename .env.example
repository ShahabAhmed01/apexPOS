# APEXPOS environment template.
# No secrets are required for local development. When real integrations are wired
# (payment providers, FBR tax bridge, update feed), document their variables here.

# Optional override for the application data directory (defaults to Electron userData).
# APEXPOS_DATA_DIR=/absolute/path/to/data

# Optional auto-update feed URL (electron-updater). Placeholder only; no feed is
# configured by default. See DEPLOYMENT.md.
# APEXPOS_UPDATE_FEED_URL=https://updates.example.com/apexpos
